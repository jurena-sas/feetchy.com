# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local session data
.claude/

# PHP backend (lives on the OVH/laceter.com server, deployed via FTP —
# not part of the Vercel-deployed Next.js app; contains config.php with
# a live DB password, must never be committed)
/api-payment-feetchy/

# reference-only static HTML template, not used by the app
/grand/
